# The AGS app is its own repository (see apps.json and docs/versions.lock.md).
# It lives here as a working checkout so scripts/bootstrap.sh can install it
# without a network round-trip, but this repo does not track its contents.
apps/

__pycache__/
*.py[cod]
*.egg-info/
node_modules/
.env
*.log
.DS_Store
sites/
brief.json

# Stray Redis dump from a local run.
dump.rdb

# k6 writes these next to the profile on every run (handleSummary). The results
# worth keeping are the curated load-tests/results-*.txt, not the raw dumps.
load-tests/k6/summary.json
load-tests/k6/calibration.json
deploy/compose/.env
