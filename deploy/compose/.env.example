# Copy to .env and edit. `.env` is gitignored; this file is not.
#
#   cp .env.example .env

# --------------------------------------------------------------------- site
# The hostname the school will actually use. This is not cosmetic: Frappe picks
# which site to serve from the request's Host header, so this must match the DNS
# record pointing at the VM, and it must match the site created on disk.
SITE_NAME=erp.ags.edu.sa

# Where Let's Encrypt sends expiry warnings. A real mailbox someone reads.
ACME_EMAIL=it@ags.edu.sa

# ----------------------------------------------------------------- secrets
# Generate, do not invent:
#   openssl rand -base64 30
#
# DB_ROOT_PASSWORD is set on first run and baked into the database volume.
# Changing it later does NOT change the database — it just stops the
# application connecting.
DB_ROOT_PASSWORD=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME

# ------------------------------------------------------------------- sizing
# Rules of thumb for a single VM. The capacity model in docs/capacity-model.md
# sizes the six-node topology; these are the one-machine equivalents.
#
# GUNICORN_WORKERS: roughly (2 x vCPU) + 1, but each worker forks a full copy
# of the Frappe app tree — about 400 MB. On a 4 vCPU / 8 GB VM, 4 workers is
# the honest number; 9 will be OOM-killed under load.
GUNICORN_WORKERS=4

# MariaDB shares the machine with the application here, so it cannot have the
# usual "70% of RAM". On 8 GB total, 1-2 GB is the sane range.
DB_BUFFER_POOL=1G
DB_MAX_CONNECTIONS=200

# ------------------------------------------------------------------ backups
# UTC. 22:15 UTC is 01:15 in Riyadh — clear of the 07:00 peak and after the
# nightly reminder and ageing passes.
BACKUP_AT_UTC=22:15
BACKUP_KEEP_DAYS=14

# ------------------------------------------------------------------- image
# The tag to run. The Release image workflow publishes to GitHub's registry on
# every push to main; its run summary names the tag. Use the immutable sha- or
# v- tag in production, never :main or :latest — an unattended
# `docker compose pull` that silently moves the ERP to a new version is how
# fees get repriced without anyone deciding to.
#
#   production:  AGS_IMAGE=ghcr.io/mohrefaey-creator/ags-edusmart-erp:sha-9aa8035e2658
#   local build: AGS_IMAGE=ags/edusmart-erp:local
AGS_IMAGE=ghcr.io/mohrefaey-creator/ags-edusmart-erp:sha-9aa8035e2658
