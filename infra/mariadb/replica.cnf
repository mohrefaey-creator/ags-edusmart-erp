# MariaDB read replica. Serves reports, dashboards and exports only.
#
# Frappe routes here via `read_from_replica` in site_config.json. Never route a
# write or a read-after-write flow to a replica: replication is asynchronous, so
# a parent who has just paid could still be shown an outstanding balance.

[mysqld]
character-set-server           = utf8mb4
collation-server               = utf8mb4_unicode_ci

innodb_buffer_pool_size        = 22G
innodb_buffer_pool_instances   = 4
innodb_flush_method            = O_DIRECT
innodb_io_capacity             = 4000

# Replicas take no writes, so durability can be relaxed for replay throughput.
# If a replica is lost it is rebuilt from the primary, not recovered.
innodb_flush_log_at_trx_commit = 2
sync_binlog                    = 0

server-id                      = 2
read_only                      = ON
super_read_only                = ON
relay_log                      = /var/log/mysql/relay-bin
relay_log_recovery             = ON

# Parallel apply keeps replication lag inside the 5s SLO during the 07:40
# attendance write burst.
slave_parallel_threads         = 8
slave_parallel_mode            = optimistic

max_connections                = 300
slow_query_log                 = 1
long_query_time                = 2
